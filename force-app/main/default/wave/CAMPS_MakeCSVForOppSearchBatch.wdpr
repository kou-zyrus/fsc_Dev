    "FORMULA59_copy0" : {
      "action" : "formula",
      "sources" : [ "DROP_FIELDS7_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "ContractDateForAchievementManagement",
          "label" : "成約日",
          "formulaExpression" : "case \"userInfo.AnalyticsIndividualCompanyHandling\"\r\n\twhen '足利不動産株式会社'\r\n\tthen CompletionDate\r\n\telse\r\n\t(\r\n\t\tcase\r\n\t\t\twhen ContractDate is not null\r\n\t\t\tthen ContractDate\r\n\t\t\twhen FollowUpDateAfterEstablishment is not null\r\n\t\t\t     or ReferralDate is not null\r\n\t\t\t     or CompletionDate is not null\r\n\t\t\tthen (\r\n\t\t\t    case\r\n\t\t\t        when coalesce(FollowUpDateAfterEstablishment, '2999-12-31') <= coalesce(ReferralDate, '2999-12-31')\r\n\t\t\t              and coalesce(FollowUpDateAfterEstablishment, '2999-12-31') <= coalesce(CompletionDate, '2999-12-31')\r\n\t\t\t        then FollowUpDateAfterEstablishment\r\n\t\t\t        when coalesce(ReferralDate, '2999-12-31') <= coalesce(FollowUpDateAfterEstablishment, '2999-12-31')\r\n\t\t\t              and coalesce(ReferralDate, '2999-12-31') <= coalesce(CompletionDate, '2999-12-31')\r\n\t\t\t        then ReferralDate\r\n\t\t\t        when coalesce(CompletionDate, '2999-12-31') <= coalesce(FollowUpDateAfterEstablishment, '2999-12-31')\r\n\t\t\t              and coalesce(CompletionDate, '2999-12-31') <= coalesce(ReferralDate, '2999-12-31')\r\n\t\t\t        then CompletionDate\r\n\t\t\t     end\r\n\t\t\t )    \r\n\t\tend\r\n\t)\r\nend",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
