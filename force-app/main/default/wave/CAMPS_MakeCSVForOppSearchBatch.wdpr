          "formulaExpression" : "array_join(\r\n    case\r\n        when \r\n        ltrim(\r\n            array_join(\r\n                array_distinct(\r\n                    array(\r\n                        'false',\r\n                        Payment__c,\r\n                        Cancellation__c,\r\n                        Reduction_SpecialCancellation__c,\r\n                        UnpaidSupport__c,\r\n                        Transfer__c,\r\n                        OtherMaintenance__c\r\n                    )\r\n                ),\r\n            ','),\r\n        'false,') = ''\r\n        then null\r\n        else\r\n        split(\r\n            ltrim(\r\n                array_join(\r\n                    array_distinct(\r\n                        array(\r\n                            'false',\r\n                            Payment__c,\r\n                            Cancellation__c,\r\n                            Reduction_SpecialCancellation__c,\r\n                            UnpaidSupport__c,\r\n                            Transfer__c,\r\n                            OtherMaintenance__c\r\n                        )\r\n                    ),\r\n                ','),\r\n            'false,'),\r\n        ',')\r\n    end,\r\n    ','\r\n)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
