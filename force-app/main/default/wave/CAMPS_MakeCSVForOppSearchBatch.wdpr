    "FORMULA97" : {
      "action" : "formula",
      "sources" : [ "REPLACE33" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Contract",
          "label" : "【プロセス】成約",
          "formulaExpression" : "array_join(\r\n    case\r\n        when \r\n        ltrim(\r\n            array_join(\r\n                array_distinct(\r\n                    array(\r\n                        'false',\r\n                        Dejimo__c,\r\n                        Paper__c,\r\n                        CallVU__c\r\n                    )\r\n                ),\r\n            ','),\r\n        'false,') = ''\r\n        then null\r\n        else\r\n        split(\r\n            ltrim(\r\n                array_join(\r\n                    array_distinct(\r\n                        array(\r\n                            'false',\r\n                            Dejimo__c,\r\n                            Paper__c,\r\n                            CallVU__c\r\n                        )\r\n                    ),\r\n                ','),\r\n            'false,'),\r\n        ',')\r\n    end,\r\n    ','\r\n)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
