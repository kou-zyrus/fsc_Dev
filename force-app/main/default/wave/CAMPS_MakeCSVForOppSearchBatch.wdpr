    "FORMULA96" : {
      "action" : "formula",
      "sources" : [ "REPLACE30" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ContractBriefExplanation",
          "label" : "【プロセス】契約概要/約款説明・交付",
          "formulaExpression" : "array_join(\r\n    case\r\n        when \r\n        ltrim(\r\n            array_join(\r\n                array_distinct(\r\n                    array(\r\n                        'false',\r\n                        WebAgreement__c,\r\n                        BookletAgreement__c,\r\n                        DisadvantageExplanationWithConditions__c,\r\n                        DisadvantageExplanation__c,\r\n                        ContractConfirmation__c\r\n                    )\r\n                ),\r\n            ','),\r\n        'false,') = ''\r\n        then null\r\n        else\r\n        split(\r\n            ltrim(\r\n                array_join(\r\n                    array_distinct(\r\n                        array(\r\n                            'false',\r\n                            WebAgreement__c,\r\n                            BookletAgreement__c,\r\n                            DisadvantageExplanationWithConditions__c,\r\n                            DisadvantageExplanation__c,\r\n                            ContractConfirmation__c\r\n                        )\r\n                    ),\r\n                ','),\r\n            'false,'),\r\n        ',')\r\n    end,\r\n    ','\r\n)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
