    "FORMULA54_copy0" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES209" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "OppType",
          "label" : "案件種類",
          "formulaExpression" : "case RecordTypeAPIName\r\n    when 'Opportunity'\r\n    then '新規'\r\n    when 'Approach'\r\n    then '新規'\r\n    when 'LeadsPlanning'\r\n    then '新規'\r\n    when 'DMOrOthers'\r\n    then 'DM/その他'\r\n    else '保全'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
