    "FORMULA83" : {
      "action" : "formula",
      "sources" : [ "JOIN28" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Commission",
          "label" : "手数料",
          "formulaExpression" : "case\r\n    when Commission_DesignDocInsurancePolicy > 0\r\n    then Commission_DesignDocInsurancePolicy\r\n    else\r\n    \"commission.Commission_IncludingRateConsideration\"\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "DROP_FIELDS12" : {
      "action" : "schema",
      "sources" : [ "FORMULA113" ],
      "parameters" : {
