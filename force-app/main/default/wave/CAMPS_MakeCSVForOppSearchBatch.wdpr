    "FORMULA9_copy0_copy0" : {
      "action" : "formula",
      "sources" : [ "LOAD_DATASET3_copy0_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "DesignDocument_ProductName_NameConversion",
          "label" : "設計書商品名_名前変換",
          "formulaExpression" : "case\r\n    when startsWith(DesignDocument_ProductName, 'Days1')='true'\r\n    then 'Days1'\r\n    when startsWith(DesignDocument_ProductName, 'EVER Prime')='true'\r\n    then 'EVERPrime'\r\n    else\r\n    DesignDocument_ProductName\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA49_copy0" : {
      "action" : "formula",
      "sources" : [ "DROP_FIELDS18" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "AnnualizedPremium",
          "label" : "年換算保険料",
          "formulaExpression" : "case OppType\r\n    when '新規'\r\n    then \"dd.AnnualizedPremium_AutoCalc__c\" + \"dd.AnnualizedPremium__c\"\r\n    when 'DM/その他'\r\n    then \"dd.AnnualizedPremium_AutoCalc__c\" + \"dd.AnnualizedPremium__c\"\r\n    when '保全'\r\n    then \"InsurancePolicy.Opportunit.AnnualBasisPremForAnalytics__c\"\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA50_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA49_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Commission_DesignDocInsurancePolicy",
          "label" : "手数料_設計書・保険契約",
          "formulaExpression" : "\r\ncase OppType\r\n    when '新規'\r\n    then \"dd.Commission_AutoCalc__c\" + \"dd.Commission__c\"\r\n    when 'DM/その他'\r\n    then \"dd.Commission_AutoCalc__c\" + \"dd.Commission__c\"\r\n    when '保全'\r\n    then \"InsurancePolicy.Opportunit.TotalCommissionAmountForAnalytics__c\"\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "DROP_FIELDS7_copy0" : {
      "action" : "schema",
      "sources" : [ "FORMULA111" ],
      "parameters" : {
        "fields" : [ ],
        "slice" : {
          "mode" : "DROP",
          "ignoreMissingFields" : true,
          "fields" : [ "dd.Expectation__c", "dd.AnnualizedPremium_AutoCalc__c", "dd.AnnualizedPremium__c", "dd.Commission_AutoCalc__c", "ReasonForCancellation__c", "dd.CancelReason__c", "CompletionDate__c", "dd.CompletionDate__c", "CancelDate__c", "dd.CancellationDateOfTheProposedProduct__c", "InsurancePolicy.Opportunit.AnnualBasisPremForAnalytics__c", "InsurancePolicy.Opportunit.InsuranceCompanyForAnalytics__c", "InsurancePolicy.Opportunit.TotalCommissionAmountForAnalytics__c", "dd.product.Column6", "dd.product.Column4", "InsurancePolicy.ProductCategory", "InsurancePolicy.ProductCategoryOrder", "dd.InsuranceProductCompanyFormula__c", "dd.LastModifiedByProfileNameForAnalytics__c", "dd.lastModifiedBy.AgentName_InactiveUserShowing", "dd.division.DivideChargeAmount__c", "dd.division.DivideChargeRate__c_number", "dd.division.DesignDocument__c" ]
        }
      }
    },
    "FORMULA69_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA73_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "OppStatus",
          "label" : "状態",
          "formulaExpression" : "array_join(\r\n     case\r\n          when  OppType='新規'\r\n          then (\r\n               case\r\n                    when StageName='未割当'\r\n                         or StageName='未対応'\r\n                    then array('未対応', '登録一覧')\r\n                    when StageName='架電'\r\n                         or StageName='接話'\r\n                         or StageName='資料送付'\r\n                         or StageName='アポ取得'\r\n                         or StageName='オープニングシート説明'\r\n                         or StageName='アプローチ'\r\n                         or StageName='実情調査'\r\n                         or StageName='商品説明'\r\n                    then array('商品提案前', '登録一覧')\r\n                    when DesignDocStageName='加入決断'\r\n                         or DesignDocStageName='契約概要/約款説明・交付'\r\n                         or DesignDocStageName='成約'\r\n                    then array('商品提案中', '登録一覧')\r\n                    when DesignDocStageName='成立後フォロー' \r\n                         or DesignDocStageName='紹介'\r\n                    then array('成約', '登録一覧')\r\n                    when DesignDocStageName='完了'\r\n                    then array('完了', '登録一覧')\r\n                    when StageName='取消'\r\n                         or DesignDocStageName='取消'\r\n                    then array('キャンセル', '登録一覧')\r\n                    else array('商品提案前', '登録一覧')\r\n               end\r\n          )\r\n          when  OppType='DM/その他'\r\n          then (\r\n               case\r\n                    when StageName='申込書受付'\r\n                         or StageName='(冊子希望の場合)約款送付'\r\n                         or StageName='不備返却'\r\n                         or StageName='商品説明'\r\n                    then array('商品提案前', '登録一覧')\r\n                    when DesignDocStageName='成約'\r\n                    then array('商品提案中', '登録一覧')\r\n                    when DesignDocStageName='成立後フォロー'\r\n                    then array('成約', '登録一覧')\r\n                    when DesignDocStageName='完了'\r\n                    then array('完了', '登録一覧')\r\n                    when StageName='取消'\r\n                         or DesignDocStageName='取消'\r\n                    then array('キャンセル', '登録一覧')\r\n                    else array('商品提案前', '登録一覧')\r\n               end\r\n          )\r\n          when OppType='保全'\r\n          then (\r\n               case\r\n                    when StageName='未割当'\r\n                         or StageName='未対応'\r\n                    then array('未対応', '受付一覧')\r\n                    when DefectiveShippingDate is null\r\n                         and DeficiencyReceiptDate is null\r\n                         and StageName!='完了'\r\n                         and StageName!='取消'\r\n                    then array('対応中', '受付一覧')\r\n                    when (DefectiveShippingDate is not null\r\n                         or DeficiencyReceiptDate is not null)\r\n                         and StageName!='完了'\r\n                         and StageName!='取消'\r\n                    then array('不備', '受付一覧')\r\n                    when StageName='完了'\r\n                    then array('完了', '受付一覧')\r\n                    when StageName='取消'\r\n                    then array('取消', '受付一覧')\r\n                    else array('対応中', '受付一覧')\r\n               end\r\n          )\r\n     end,\r\n     ','\r\n)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA70_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA78" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ReasonForCancellation",
          "label" : "取消理由/解約理由",
          "formulaExpression" : "case OppType\r\n    when '新規'\r\n    then \"dd.CancelReason__c\"\r\n    when 'DM/その他'\r\n    then \"dd.CancelReason__c\"\r\n    when '保全'\r\n    then ReasonForCancellation__c\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA71_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA70_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "CompletionDate",
          "label" : "完了日",
          "formulaExpression" : "case OppType\r\n    when '新規'\r\n    then \"dd.CompletionDate__c\"\r\n    when 'DM/その他'\r\n    then \"dd.CompletionDate__c\"\r\n    when '保全'\r\n    then CompletionDate__c\r\nend",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA72_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA71_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "CancelDate",
          "label" : "取消日",
          "formulaExpression" : "case\r\n    when \"dd.CancellationDateOfTheProposedProduct__c\" is not null\r\n    then \"dd.CancellationDateOfTheProposedProduct__c\"\r\n    else\r\n    CancelDate__c\r\nend",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA73_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA50_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "InsuranceCompany",
          "label" : "保険会社",
          "formulaExpression" : "case OppType\r\n    when '新規'\r\n    then \"dd.InsuranceProductCompanyFormula__c\"\r\n    when 'DM/その他'\r\n    then \"dd.InsuranceProductCompanyFormula__c\"\r\n    when '保全'\r\n    then \"InsurancePolicy.Opportunit.InsuranceCompanyForAnalytics__c\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA75_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA69_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Expectation",
          "label" : "見込み",
          "formulaExpression" : "case\r\n    when \"dd.Expectation__c\" is not null\r\n    then \"dd.Expectation__c\"\r\n    when DesignDocId is not null\r\n    then '未定'\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA77" : {
      "action" : "formula",
      "sources" : [ "FORMULA75_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductCategory",
          "label" : "商品領域",
          "formulaExpression" : "case OppType\r\n    when '新規'\r\n    then \"dd.product.Column4\"\r\n    when 'DM/その他'\r\n    then \"dd.product.Column4\"\r\n    when '保全'\r\n    then \"InsurancePolicy.ProductCategory\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA78" : {
      "action" : "formula",
      "sources" : [ "FORMULA77" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductCategoryOrder",
          "label" : "商品領域順",
          "formulaExpression" : "case OppType\r\n    when '新規'\r\n    then \"dd.product.Column6\"\r\n    when 'DM/その他'\r\n    then \"dd.product.Column6\"\r\n    when '保全'\r\n    then \"InsurancePolicy.ProductCategoryOrder\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA101" : {
      "action" : "formula",
      "sources" : [ "FORMULA72_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductName",
          "label" : "提案商品",
          "formulaExpression" : "case\r\n    when \"dd.ConditionalCancelDivisionForAnalytics__c\" is not null\r\n    then concat(ProductName_WithoutConditionalCancel, ' ', \"dd.ConditionalCancelDivisionForAnalytics__c\")\r\n    else\r\n    ProductName_WithoutConditionalCancel\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA109" : {
      "action" : "formula",
      "sources" : [ "FORMULA101" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "LastModifiedBy",
          "label" : "最終更新者",
          "formulaExpression" : "case\r\n    when \"dd.LastModifiedByProfileNameForAnalytics__c\" != '経営者_Member'\r\n        and \"dd.LastModifiedByProfileNameForAnalytics__c\" != '出先管理者_Member'\r\n        and \"dd.LastModifiedByProfileNameForAnalytics__c\" != '募集人_Member'\r\n    then 'システム更新'\r\n    else\r\n    \"dd.lastModifiedBy.AgentName_InactiveUserShowing\"\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
