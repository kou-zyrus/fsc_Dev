        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductCategory",
          "label" : "保険契約商品領域",
          "formulaExpression" : "case\r\n    when \"Opportunit.InsurancePolicy__c\" is not null\r\n    then (\r\n        case\r\n            when \"product.Column4\" is not null\r\n            then \"product.Column4\"\r\n            when \"Opportunit.ProductCodeForAnalytics__c\" = '他社'\r\n            then '他社'\r\n            when \"product.Column4\" is null\r\n            then 'その他'\r\n        end\r\n    )\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
