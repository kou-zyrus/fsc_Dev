          "ignoreMissingFields" : true,
          "fields" : [ "commission.Commission_IncludingRateConsideration", "Commission_DesignDocInsurancePolicy", "dd.Commission__c", "dd.CommissionRate__c", "commission.commission.CommissionPercent__c", "dd.InsuranceProductCompany__c", "dd.ConditionalCancelDivisionForAnalytics__c" ]
        }
      }
    },
    "FORMULA113" : {
      "action" : "formula",
      "sources" : [ "FORMULA83" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CommissionRate",
          "label" : "手数料率",
          "formulaExpression" : "case\r\n    when \"dd.CommissionRate__c\" > 0\r\n    then \"dd.CommissionRate__c\"/100\r\n    when \"dd.Commission__c\" > 0\r\n    then round(\"dd.Commission__c\"/AnnualizedPremium, 5)\r\n    else \"commission.commission.CommissionPercent__c\"/100\r\nend",
          "precision" : 10,
          "scale" : 5,
          "defaultValue" : ""
        } ]
      }
    },
