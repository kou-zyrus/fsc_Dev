          "name" : "ConditionalCancelDivisionForAnalytics__c_replace",
          "label" : "条件付解約区分(Analytics)",
          "formulaExpression" : "coalesce(ConditionalCancelDivisionForAnalytics__c, null, 'null')",
          "precision" : 255
        } ]
      }
    },
    "FORMULA120" : {
      "action" : "formula",
      "sources" : [ "FORMULA81" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductPlanUnit",
          "label" : "商品プラン名結合",
          "formulaExpression" : "case\r\n    when contains(ProductName__c,'あんしんパレット')\r\n    then (\r\n        case\r\n        when SalesPlan__c is not null\r\n        then concat(ProductName__c,' ','(',SalesPlan__c,')')\r\n        else\r\n        concat(ProductName__c,' ','(-)')\r\n        end\r\n    )\r\n    else\r\n    ProductName__c\r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
