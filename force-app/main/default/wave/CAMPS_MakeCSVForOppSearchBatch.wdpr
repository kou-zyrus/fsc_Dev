me", "userInfo.AS_Code__c", "userInfo.AS_Name", "userInfo.AanetId", "userInfo.Admin_identifier", "userInfo.Agent_Code", "userInfo.Agent_Name", "userInfo.AnalyticsIndividualCompanyHandling", "userInfo.DevelopmentAdmin_identifier", "userInfo.Executive_identifier", "userInfo.Filter_Sort_Order", "userInfo.OperationAdmin_identifier", "userInfo.SalesMarketingDepartment_identifier", "userInfo.SystemAdmin_identifier", "userInfo.TeamName", "userInfo.UserIsActive" ]
