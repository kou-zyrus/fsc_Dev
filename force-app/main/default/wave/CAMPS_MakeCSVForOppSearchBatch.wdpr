    "FORMULA119" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES175" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductPlanUnit",
          "label" : "商品プラン名結合",
          "formulaExpression" : "case\r\n    when contains(\"dd.ProductName__c\",'あんしんパレット')\r\n    then (\r\n        case\r\n        when \"dd.SalesPlan__c\" is not null\r\n        then concat(\"dd.ProductName__c\",' ','(',\"dd.SalesPlan__c\",')')\r\n        else\r\n        concat(\"dd.ProductName__c\",' ','(-)')\r\n        end\r\n    )\r\n    else\r\n    \"dd.ProductName__c\"\r\nend ",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "EDIT_ATTRIBUTES210" : {
      "action" : "schema",
      "sources" : [ "FORMULA119" ],
      "parameters" : {
        "fields" : [ {
          "name" : "ProductPlanUnit",
          "newProperties" : {
            "label" : "提案商品（条件付き解約なし）",
            "name" : "ProductName_WithoutConditionalCancel"
          }
        } ]
      }
    },
