    "FORMULA110" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES183" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "MainAgent_DivisionAP",
          "label" : "営業担当者_分配後AP",
          "formulaExpression" : "case\r\n    when DesignDocId is not null\r\n         and \"dd.division.DesignDocument__c\" is null\r\n    then AnnualizedPremium\r\n    else\r\n    \"dd.division.DivideChargeAmount__c\"\r\nend\r\n",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA111" : {
      "action" : "formula",
      "sources" : [ "FORMULA110" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "MainAgent_DivisionRate",
          "label" : "営業担当者_分配率",
          "formulaExpression" : "case\r\n    when DesignDocId is not null\r\n         and \"dd.division.DesignDocument__c\" is null\r\n    then 1\r\n    else\r\n    \"dd.division.DivideChargeRate__c_number\"\r\nend",
          "precision" : 10,
          "scale" : 2,
          "defaultValue" : ""
        } ]
      }
    },
