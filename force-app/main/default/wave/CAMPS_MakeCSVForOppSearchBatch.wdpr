    "FORMULA8_copy0_copy0" : {
      "action" : "formula",
      "sources" : [ "JOIN30" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductName_NameConversion",
          "label" : "提案商品(主契約) 名前変換",
          "formulaExpression" : "case\r\n    when startsWith(ProductName__c, 'Days1')='true'\r\n    then 'Days1'\r\n    when startsWith(ProductName__c, 'EVER Prime')='true'\r\n    then 'EVERPrime'\r\n    else\r\n    ProductName__c\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
