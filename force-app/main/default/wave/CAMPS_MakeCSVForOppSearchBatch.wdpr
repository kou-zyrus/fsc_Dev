    "FORMULA86" : {
      "action" : "formula",
      "sources" : [ "FORMULA85" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "TargetAP",
          "label" : "目標AP",
          "formulaExpression" : "case \"month.Column1\"\r\n    when 1\r\n    then TargetAP__c\r\n    when 2\r\n    then TargetAP2__c\r\n    when 3\r\n    then TargetAP3__c\r\n    when 4\r\n    then TargetAP4__c\r\n    when 5\r\n    then TargetAP5__c\r\n    when 6\r\n    then TargetAP6__c\r\n    when 7\r\n    then TargetAP7__c\r\n    when 8\r\n    then TargetAP8__c\r\n    when 9\r\n    then TargetAP9__c\r\n    when 10\r\n    then TargetAP10__c\r\n    when 11\r\n    then TargetAP11__c\r\n    when 12\r\n    then TargetAP12__c\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA88" : {
      "action" : "formula",
      "sources" : [ "FORMULA107" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "ProductCategoryOrder",
          "label" : "保険契約商品領域順",
          "formulaExpression" : "case\r\n    when \"Opportunit.InsurancePolicy__c\" is not null\r\n    then (\r\n        case\r\n            when \"product.Column6\" is not null\r\n            then \"product.Column6\"\r\n            when \"Opportunit.ProductCodeForAnalytics__c\" = '他社'\r\n            then '99'\r\n            when \"product.Column6\" is null\r\n            then '7'\r\n        end\r\n    )\r\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA107" : {
      "action" : "formula",
