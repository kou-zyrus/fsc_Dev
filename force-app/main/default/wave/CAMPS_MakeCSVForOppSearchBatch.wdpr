    "FORMULA79" : {
      "action" : "formula",
      "sources" : [ "JOIN27" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Commission_IncludingRateConsideration",
          "label" : "手数料_手数料率考慮含む",
          "formulaExpression" : "case\r\n    when ContractDateForAchievementManagement >= \"commission.CommissionStartDate_FilledInTheBlank\"\r\n         and ContractDateForAchievementManagement <= \"commission.CommissionEndDate_FilledInTheBlank\"\r\n    then round(AnnualizedPremium * \"commission.CommissionPercent__c\" / 100, 0)\r\n    when ContractDateForAchievementManagement is null\r\n         and ReceptionDate >= \"commission.CommissionStartDate_FilledInTheBlank\"\r\n         and ReceptionDate <= \"commission.CommissionEndDate_FilledInTheBlank\"\r\n    then round(AnnualizedPremium * \"commission.CommissionPercent__c\" / 100, 0)\r\n    else 0\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA114" : {
      "action" : "formula",
      "sources" : [ "FORMULA79" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "IsDuringApplicablePeriod",
          "label" : "適用期間内フラグ",
          "formulaExpression" : "case\r\n    when ContractDateForAchievementManagement >= \"commission.CommissionStartDate_FilledInTheBlank\"\r\n         and ContractDateForAchievementManagement <= \"commission.CommissionEndDate_FilledInTheBlank\"\r\n    then 1\r\n    when ContractDateForAchievementManagement is null\r\n         and ReceptionDate >= \"commission.CommissionStartDate_FilledInTheBlank\"\r\n         and ReceptionDate <= \"commission.CommissionEndDate_FilledInTheBlank\"\r\n    then 1\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA80" : {
      "action" : "formula",
      "sources" : [ "FILTER14" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "CommissionStartDate_FilledInTheBlank",
          "label" : "適用開始日_ブランク埋め",
          "formulaExpression" : "case\r\n    when CommissionStartDate__c is null\r\n    then to_timestamp('1970-01-01')\r\n    else\r\n    CommissionStartDate__c\r\nend",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA81" : {
      "action" : "formula",
      "sources" : [ "FORMULA80" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "DATETIME",
          "name" : "CommissionEndDate_FilledInTheBlank",
          "label" : "適用終了日_ブランク埋め",
          "formulaExpression" : "case\r\n    when CommissionEndDate__c is null\r\n    then to_timestamp('2999-12-31')\r\n    else\r\n    CommissionEndDate__c\r\nend",
          "format" : "yyyy-MM-dd",
          "defaultValue" : ""
        } ]
      }
    },
    "REPLACE48" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES211" ],
      "schema" : {
        "fields" : [ {
          "name" : "ConditionalCancelDivisionForAnalytics__c_replace",
