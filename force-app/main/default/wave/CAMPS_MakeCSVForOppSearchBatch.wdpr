    "FORMULA67_copy0" : {
      "action" : "formula",
      "sources" : [ "EDIT_ATTRIBUTES116_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CampaignChannelOrder",
          "label" : "募集企画受付経路順",
          "formulaExpression" : "case CampaignChannel\r\n    when '既契約者フォロー'\r\n    then 1\r\n    when '保全対応'\r\n    then 2\r\n    when '店頭来店'\r\n    then 3\r\n    when '紹介'\r\n    then 4\r\n    when 'アフラックメール'\r\n    then 5\r\n    when '白地開拓'\r\n    then 6\r\n    when 'DM'\r\n    then 7\r\n    when 'チラシ'\r\n    then 8\r\n    when '団体募集'\r\n    then 9\r\n    when 'ホームページ'\r\n    then 10\r\n    when 'その他'\r\n    then 11\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA74_copy0" : {
      "action" : "formula",
      "sources" : [ "FORMULA67_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "IncomingChannel_Leads_Order",
          "label" : "受付経路/リーズ元等順",
          "formulaExpression" : "case \r\n    when IncomingChannel_Leads is null\r\n    then 9999999999\r\n    else\r\n    \"IncomingCh.DisplayOrder__c\"\r\nend",
          "precision" : 18,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "DROP_FIELDS10_copy0" : {
      "action" : "schema",
      "sources" : [ "FORMULA74_copy0" ],
      "parameters" : {
        "fields" : [ ],
        "slice" : {
          "mode" : "DROP",
          "ignoreMissingFields" : true,
          "fields" : [ "IncomingCh.DisplayOrder__c" ]
        }
      }
    },
    "FORMULA76" : {
      "action" : "formula",
      "sources" : [ "DROP_FIELDS10_copy0" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "NumberOfDaysFromContractToCancellation",
          "label" : "契約から解約までの日数",
          "formulaExpression" : "case\r\n    when CompletionDate__c is not null\r\n         and \"InsurancePolicy.Opportunit.ContractDateForAnalytics__c\" is not null\r\n         and datediff(CompletionDate__c, \"InsurancePolicy.Opportunit.ContractDateForAnalytics__c\")>=0\r\n         and datediff(CompletionDate__c, \"InsurancePolicy.Opportunit.ContractDateForAnalytics__c\")<=999\r\n    then datediff(CompletionDate__c, \"InsurancePolicy.Opportunit.ContractDateForAnalytics__c\")\r\n    else\r\n    999\r\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "DROP_FIELDS11" : {
      "action" : "schema",
      "sources" : [ "FORMULA76" ],
      "parameters" : {
        "fields" : [ ],
        "slice" : {
          "mode" : "DROP",
          "ignoreMissingFields" : true,
          "fields" : [ "InsurancePolicy.Opportunit.ContractDateForAnalytics__c" ]
        }
      }
    },
