e":12,"textWrap":true},"columnProperties":{},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfLines":1,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"filter_DM_LocationAccompany":{"broadcastFacet":true,"groups":[],"label":"フィルター_【DM】【プロセス】実施場所","numbers":[],"query":"q = load \"AchievementManagement_OppSearch_OppAssociatedData\";\nq = group q by 'LocationAccompany';\nq = foreach q generate 'LocationAccompany' as 'LocationAccompany', \n        case LocationAccompany\n            when \"自宅\" then 1\n            when \"代理店事務所\" then 2\n            when \"その他\" then 3\n        end as 'order';\nq = order q by 'order' asc;\nq = limit q 2000;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"multi","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"table_Maint_OppList":{"broadcastFacet":true,"groups":[],"label":"テーブル_【保全】案件一覧","numbers":[],"query":"q = load \"AchievementManagement_OppSearch_OppAssociatedData\";\n\nq = filter q by \n    (\n        'OppType' == \"保全\"\n        and 'RecordTypeAPIName' == \"{{cell(filter_Maint_RecordType.selection, 0, \"APIName\").asString()}}\"\n        and 'OppStatus' in [\"{{cell(filter_Maint_OppStatus.selection, 0, \"Status\").asString()}}\"]\n        --03.保全(代理店)、保全(ACE)の時はプロセスフィルターに連動、お客様の声、証券発送の時は画面上プロセスを入力できないためプロセスが選択されていてもプロセスフィルターに連動はしない\n        and (\n            (\n                \"{{cell(filter_Maint_RecordType.selection, 0, \"APIName\").asString()}}\" == \"maintenance_agency\"\n                and {{column(filter_Maint_Reception.selection, [\"Reception_MaintBenefitWorkType\"]).asEquality(\"Reception_MaintBenefitWorkType\")}}\n                and {{column(filter_Maint_DucumentTransfer.selection, [\"DucumentTransfer\"]).asEquality(\"DucumentTransfer\")}}\n            )\n            or \"{{cell(filter_Maint_RecordType.selection, 0, \"APIName\").asString()}}\" == \"VoiceOfTheCustomer\"\n            or \"{{cell(filter_Maint_RecordType.selection, 0, \"APIName\").asString()}}\" == \"SendPolicy\"\n            or (\n                \"{{cell(filter_Maint_RecordType.selection, 0, \"APIName\").asString()}}\" == \"Maintenance_ACE\"\n                and {{column(filter_Maint_Reception.selection, [\"Reception_MaintBenefitWorkType\"]).asEquality(\"Reception_MaintBenefitWorkType\")}}\n                and {{column(filter_Maint_DucumentTransfer.selection, [\"DucumentTransfer\"]).asEquality(\"DucumentTransfer\")}}\n            )\n        )\n    )\n;\n\nq = foreach q generate\n    'ReceptionDate',\n    'DefectiveShippingDate2',\n    'CompletionDate2',\n    'CancelDate2',\n    'OppId',\n    'OppName',\n    'MaintenanceWorkPattern',\n    'AccountId',\n    'AccountName',\n    'GroupName',\n    'IncomingChannel_Leads',\n    'Agent_Name',\n    'ProceedingStaff_Name'\n    {{cell(filter_Maint_RecordType.selection, 0, \"DateFields\").asObject()}},\n    'InsurancePolicyId',\n    'InsurancePolicyProductName',\n    'AnnualizedPremium',\n    'Commission',\n    (case \n    \twhen mv_to_string('OppStatus') matches \"未対応\" then \"未対応\"\n    \twhen mv_to_string('OppStatus') matches \"対応中\" then \"対応中\"\n    \twhen mv_to_string('OppStatus') matches \"不備\" then \"不備\"\n    \twhen mv_to_string('OppStatus') matches \"完了\" then \"完了\"\n    \twhen mv_to_string('OppStatus') matches \"取消\" then \"取消\"\n    end) as 'OppStatus',\n    'AS_Code',\n    mv_to_string('Reception_MaintBenefitWorkType') as 'Reception_MaintBenefitWorkType',\n    mv_to_string('DucumentTransfer') as 'DucumentTransfer'\n;\n\nq = group q by (\n    {{cell(filter_Maint_OppStatus.selection, 0, \"DateFilterAPIName\").asString()}},\n    'OppId',\n    'OppName',\n    'MaintenanceWorkPattern',\n    'AccountId',\n    'AccountName',\n    'GroupName',\n    'IncomingChannel_Leads',\n    'Agent_Name',\n    'ProceedingStaff_Name'\n    {{cell(filter_Maint_RecordType.selection, 0, \"DateFields\").asObject()}},\n    'InsurancePolicyId',\n    'InsurancePolicyProductName',\n    'AnnualizedPremium',\n    'Commission',\n    'OppStatus',\n    'AS_Code',\n    'Reception_MaintBenefitWorkType',\n    'DucumentTransfer'\n);\n\n--No、保険契約No項目作成（この時点でStringにすることで、項目を前に持ってくる※数値だと後ろにいってしまうため）\nq = foreach q generate\n    number_to_string(\n\t\tdense_rank() over(\n\t\t\t[..] partition by all \n\t\t\torder by (\n\t\t\t\t{{cell(filter_Maint_OppStatus.selection, 0, \"DateFilterAPIName\").asString()}} desc nulls last,\n\t\t\t\t'AS_Code' asc, \n\t\t\t\tOppId desc\n\t\t\t)\n\t\t),\n\t\"##\") as 'No',\n    {{cell(filter_Maint_OppStatus.selection, 0, \"DateFilterAPIName\").asString()}},\n    'OppId',\n    'OppName',\n    'MaintenanceWorkPattern',\n    'AccountId',\n    'AccountName',\n    'GroupName',\n    'IncomingChannel_Leads',\n    'Agent_Name',\n    'ProceedingStaff_Name'\n    {{cell(filter_Maint_RecordType.selection, 0, \"DateFields\").asObject()}},\n    (case \n        when 'InsurancePolicyId' is not null\n        then\n        number_to_string(\n            dense_rank() over(\n                [..] partition by all \n                order by (\n                    {{cell(filter_Maint_OppStatus.selection, 0, \"DateFilterAPIName\").asString()}} desc nulls last,\n                    'AS_Code' asc, \n                    OppId desc\n                )\n            ),\n        \"##\")\n        + \"-\"\n        + number_to_string(\n            row_number() over(\n                [..] partition by 'OppId' \n                order by 'InsurancePolicyId' desc\n            ), \"##\"\n        )\n    end) as '保険契約No',\n    'InsurancePolicyProductName',\n    'AnnualizedPremium',\n    'Commission',\n    'OppStatus',\n    'Reception_MaintBenefitWorkType',\n    'DucumentTransfer'\n;\n\n--最終的な出力（設計書No作成時点で並び順がバラバラになってしまう。そこで、最終的にNoで並び替えするためにNoを数値に戻す）※保険契約Noを作成しなければNo作成時のorderが効く\nq = foreach q generate\n    string_to_number('No') as 'No',\n    {{cell(filter_Maint_OppStatus.selection, 0, \"DateFilterAPIName\").asString()}},\n    'OppId',\n    'OppName',\n    'MaintenanceWorkPattern' as 'MaintenanceWorkPattern',\n    'AccountId',\n    'AccountName',\n    'GroupName',\n    'IncomingChannel_Leads',\n    'Agent_Name',\n    'ProceedingStaff_Name'\n    {{cell(filter_Maint_RecordType.selection, 0, \"DateFields\").asObject()}},\n    '保険契約No',\n    'InsurancePolicyProductName',\n    'AnnualizedPremium',\n    (\n    \tcase\n    \t\twhen \"{{cell(query_ViewersInfo.result, 0, \"CampsCommissionVisibility\").asString()}}\" == \"閲覧不可\" then null\n    \t\telse 'Commission'\n    \tend\n    ) as 'Commission',\n    'OppStatus',\n    {{cell(filter_Maint_RecordType.selection, 0, \"ProcessFields\").asObject()}}\n    \"{{cell(filter_Maint_RecordType.selection, 0, \"APIName\").asString()}}\" as 'recordTypeAPIName',\n    \"{{cell(filter_Maint_OppStatus.selection, 0, \"Status\").asString()}}\" as 'OppStatusSelection',\n    \"OppSearch_Maint_OppList\" as 'downloadDefinition'\n;\n\nq = order q by 'No';\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["filter_Maint_MaintenanceWorkPattern","filter_Maint_ReasonForCancellation","filter_Maint_Date","filter_Common_AS","filter_Common_ASBranch","filter_Common_Agent","filter_Common_Account","filter_Common_Group","filter_Common_IncomingChannel_Leads","filter_Common_Team"]},"selectMode":"single","start":"[]","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#e0e5ee","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":false},"columnProperties":{},"columns":[],"customBulkActions":[{"label":"CSV形式でダウンロード","visualforce":{"name":"AnalyticsQueryDataDownload","namespace":""}}],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#a8b7c7","innerMinorBorderColor":"#e0e5ee","interactions":[],"maxColumnWidth":300,"minColumnWidth":40,"mode":"variable","numberOfFrozenColumns":5,"numberOfLines":1,"pivoted":false,"showActionMenu":true,"totals":true,"verticalPadding":8},"type":"table"}},"filter_DM_InsuranceCompany":{"broadcastFacet":true,"datasets":[{"name":"AchievementManagement_OppSearch_OppAssociatedData"}],"isGlobal":false,"label":"フィルター_【DM】保険会社","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"{{cell(filter_DM_OppStatus.selection, 0, \\\"InsuranceCompanyFilter\\\").asString()}}\"],\"filters\":[[\"OppType\",[\"DM/その他\",