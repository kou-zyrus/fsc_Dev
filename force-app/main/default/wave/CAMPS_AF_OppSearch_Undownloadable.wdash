mentManagement_GroupingField\";\nq = group q by all;\nq1 = foreach q generate\n    \"{{cell(query_Maint_RecordTypeInfo.result, 0, \"Name\").asString()}}\" as 'Label',\n    \"maintenance_agency\" as 'APIName',\n    \", 'DocumentDeliveryDate', 'DocumentReceiptDate', 'DefectiveShippingDate', 'DeficiencyReceiptDate', 'CompletionDate', 'CancelDate'\" as 'DateFields',\n    \"'Reception_MaintBenefitWorkType','DucumentTransfer',\" as 'ProcessFields'\n;\nq2 = foreach q generate\n    \"{{cell(query_Maint_RecordTypeInfo.result, 1, \"Name\").asString()}}\" as 'Label',\n    \"VoiceOfTheCustomer\" as 'APIName',\n    \", 'FactConfirmationDate', 'ReportCreationDate', 'InsuranceCompanyReportDate', 'MeasuresToPreventARelapseDate', 'CompletionDate', 'CancelDate'\" as 'DateFields'\n;\nq3 = foreach q generate\n    \"{{cell(query_Maint_RecordTypeInfo.result, 2, \"Name\").asString()}}\" as 'Label',\n    \"SendPolicy\" as 'APIName',\n    \", 'ContactDate', 'VisitDate', 'UpdateInfoDate', 'CompletionDate', 'CancelDate'\" as 'DateFields'\n;\nq4 = foreach q generate\n    \"{{cell(query_Maint_RecordTypeInfo.result, 3, \"Name\").asString()}}\" as 'Label',\n    \"Maintenance_ACE\" as 'APIName',\n    \", 'DocumentDeliveryDate', 'DocumentReceiptDate', 'DefectiveShippingDate', 'DeficiencyReceiptDate', 'CompletionDate', 'CancelDate'\" as 'DateFields',\n    \"'Reception_MaintBenefitWorkType','DucumentTransfer',\" as 'ProcessFields'\n;\n\nq = union q1, q2, q3, q4;\nq = limit q 4;","receiveFacetSource":{"mode":"none","steps":[]},"selectMode":"singlerequired","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip"