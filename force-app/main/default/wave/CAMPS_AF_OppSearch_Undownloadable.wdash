"DesignDocGroupCode\"}"]},"filter_Maint_OppStatus":{"broadcastFacet":false,"groups":[],"label":"フィルター_【保全】案件状態","numbers":[],"query":"q = load \"AchievementManagement_GroupingField\";\nq = group q by all;\nq1 = foreach q generate\n\t\"受付一覧\" as 'Status',\n\t\"受付日\" as 'DateFilterLabel',\n\t\"ReceptionDate\" as 'DateFilterAPIName',\n\t\"ReasonForCancellation_unselectable\" as 'ReasonForCancellationFilter',\n\t\"maintenance_agency, VoiceOfTheCustomer, Maintenance_ACE, SendPolicy\" as 'RecordType'\n;\nq2 = foreach q generate\n\t\"未対応\" as 'Status',\n\t\"受付日\" as 'DateFilterLabel',\n\t\"ReceptionDate\" as 'DateFilterAPIName',\n\t\"ReasonForCancellation_unselectable\" as 'ReasonForCancellationFilter',\n\t\"Maintenance_ACE, SendPolicy\" as 'RecordType'\n;\nq3 = foreach q generate\n\t\"対応中\" as 'Status',\n\t\"受付日\" as 'DateFilterLabel',\n\t\"ReceptionDate\" as 'DateFilterAPIName',\n\t\"ReasonForCancellation_unselectable\" as 'ReasonForCancellationFilter',\n\t\"maintenance_agency, VoiceOfTheCustomer, Maintenance_ACE, SendPolicy\" as 'RecordType'\n;\nq4 = foreach q generate\n\t\"不備\" as 'Status',\n\t\"不備発送日\" as 'DateFilterLabel',\n\t\"DefectiveShippingDate2\" as 'DateFilterAPIName',\n\t\"ReasonForCancellation_unselectable\" as 'ReasonForCancellationFilter',\n\t\"maintenance_agency, Maintenance_ACE\" as 'RecordType'\n;\nq5 = foreach q generate\n\t\"完了\" as 'Status',\n\t\"完了日\" as 'DateFilterLabel',\n\t\"CompletionDate2\" as 'DateFilterAPIName',\n\t\"ReasonForCancellation_unselectable\" as 'ReasonForCancellationFilter',\n\t\"maintenance_agency, VoiceOfTheCustomer, Maintenance_ACE, SendPolicy\" as 'RecordType'\n;\nq6 = foreach q generate\n\t\"取消\" as 'Status',\n\t\"取消日\" as 'DateFilterLabel',\n\t\"CancelDate2\" as 'DateFilterAPIName',\n\t\"ReasonForCancellation\" as 'ReasonForCancellationFilter',\n\t\"maintenance_agency, VoiceOfTheCustomer, Maintenance_ACE, SendPolicy\" as 'RecordType'\n;\n\nq = union q1, q2, q3, q4, q5, q6;\nq = filter q by 'RecordType' like \"%{{cell(filter_