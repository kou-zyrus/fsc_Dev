lGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\tmv_to_string('HandlingOfTheElderly') as 'HandlingOfTheElderly',\n\t'ImpDateWithRelatives' as '親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'ImpDateAccompany' as '同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'ImpDatePluralMeeting' as '複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'ImpDate2PluralMeeting' as '実施日②',\n\t'Location2PluralMeeting',\n\t'ImpDateTelephone' as '電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\tmv_to_string('ContractBriefExplanation') as 'ContractBriefExplanation',\n\tmv_to_string('Contract') as 'Contract'\n;\n\n--パフォーマンス向上のため先にlimit2000を入れる\nq = order q by (\n\t{{cell(filter_New_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}} desc nulls last,\n\t'AS_Code' asc, \n\t'OppId' desc,\n\t'DesignDocId' desc\n);\n\nq = limit q 2000;\n\n--同じ案件をまとめる、window関数を使用するためにグルーピング\nq = group q by (\n\t{{cell(filter_New_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}}, \n\t'CampaignName',\n\t'CampaignChannel',\n\t'OppId',\n\t'OppName',\n\t'ProjectName',\n\t'AccountId', \n\t'AccountName', \n\t'GroupName',\n\t'IncomingChannel_Leads',\n\t'Agent_Name',\n\t'ProceedingStaff_Name',\n\t'CallDate',\n\t'CloseTalkDate',\n\t'DocumentSendDate',\n\t'AppointmentAcquisitionDate', \n\t'OpeningSheetDescripDate', \n\t'ApproachDate', \n\t'FactFindingDate', \n\t'ProductDescriptionDate', \n\t'DesignDocId', \n\t'JoinDecisionDate', \n\t'ContractAgreementDate', \n\t'ContractDate', \n\t'FollowUpDateAfterEstablishment', \n\t'ReferralDate', \n\t'CompletionDate', \n\t'CancelDate', \n\t'ProductName',\n\t'DesignDocGroupName',\n\t'PolicyNumber',\n\t'InsuranceCompany',\n\t'Expectation', \n\t'PaymentMethod',\n\t'PremiumAmount',\n\t'AnnualizedPremium',\n\t'Commission',\n\t'OppStatus',\n\t'AS_Code',\n\t'Call',\n\t'AppointmentSetting',\n\t'Approach',\n\t'InitialGraspIntentionDate',\n\t'FinalGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\t'HandlingOfTheElderly',\n\t'親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'実施日②',\n\t'Location2PluralMeeting',\n\t'電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\t'ContractBriefExplanation',\n\t'Contract'\n);\n\n--No、設計書No項目作成（この時点でStringにすることで、項目を前に持ってくる※数値だと後ろにいってしまうため）\nq = foreach q generate\n\tnumber_to_string(\n\t\tdense_rank() over(\n\t\t\t[..] partition by all \n\t\t\torder by (\n\t\t\t\t{{cell(filter_New_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}} desc nulls last,\n\t\t\t\t'AS_Code' asc, \n\t\t\t\t'OppId' desc\n\t\t\t)\n\t\t), \"##\"\n\t) as 'No',\n\t{{cell(filter_New_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}},\n\t'CampaignName',\n\t'CampaignChannel',\n\t'OppId',\n\t'OppName',\n\t'ProjectName',\n\t'AccountId',\n\t'AccountName', \n\t'GroupName',\n\t'IncomingChannel_Leads', \n\t'Agent_Name', \n\t'ProceedingStaff_Name', \n\t'CallDate', \n\t'CloseTalkDate', \n\t'DocumentSendDate', \n\t'AppointmentAcquisitionDate', \n\t'OpeningSheetDescripDate', \n\t'ApproachDate',\n\t'FactFindingDate',\n\t'ProductDescriptionDate',\n\t'DesignDocId',\n\tnumber_to_string(\n\t\trow_number() over(\n\t\t\t[..] partition by 'OppId' \n\t\t\torder by 'DesignDocId' desc\n\t\t), \"##\"\n\t) as '設計書No',\n\t'JoinDecisionDate', \n\t'ContractAgreementDate',\n\t'ContractDate', \n\t'FollowUpDateAfterEstablishment',\n\t'ReferralDate',\n\t'CompletionDate',\n\t'CancelDate',\n\t'ProductName',\n\t'DesignDocGroupName',\n\t'PolicyNumber',\n\t'InsuranceCompany',\n\t'Expectation',\n\t'PremiumAmount',\n\t'PaymentMethod',\n\t'AnnualizedPremium',\n\t'Commission',\n\t'OppStatus',\n\t'Call',\n\t'AppointmentSetting',\n\t'Approach',\n\t'InitialGraspIntentionDate',\n\t'FinalGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\t'HandlingOfTheElderly',\n\t'親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'実施日②',\n\t'Location2PluralMeeting',\n\t'電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\t'ContractBriefExplanation',\n\t'Contract'\n;\n\n--最終的な出力（設計書No作成時点で並び順がバラバラになってしまう。そこで、最終的にNoで並び替えするためにNoを数値に戻す）※設計書Noを作成しなければNo作成時のorderが効く\nq = foreach q generate\n\tstring_to_number('No') as 'No',\n\t(\n\t\tcase {{cell(filter_New_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}}\n\t\t\twhen \"-\" then null\n\t\t\telse {{cell(filter_New_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}}\n\t\tend\n\t) as {{cell(filter_New_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}},\n\t'CampaignName',\n\t'CampaignChannel',\n\t'OppId',\n\t'OppName',\n\t'ProjectName',\n\t'AccountId',\n\t'AccountName', \n\t'GroupName',\n\t'IncomingChannel_Leads', \n\t'Agent_Name', \n\t'ProceedingStaff_Name', \n\t'CallDate', \n\t'CloseTalkDate', \n\t'DocumentSendDate', \n\t'AppointmentAcquisitionDate', \n\t'OpeningSheetDescripDate', \n\t'ApproachDate',\n\t'FactFindingDate',\n\t'ProductDescriptionDate',\n\t'DesignDocId',\n\t(\n\t\tcase \n\t\t\twhen 'DesignDocId' is not null then 'No' + \"-\" + '設計書No'\n\t\tend\n\t) as '設計書No',\n\t'JoinDecisionDate', \n\t'ContractAgreementDate',\n\t'ContractDate', \n\t'FollowUpDateAfterEstablishment',\n\t'ReferralDate',\n\t'CompletionDate',\n\t'CancelDate',\n\t'ProductName',\n\t'DesignDocGroupName',\n\t'PolicyNumber',\n\t'InsuranceCompany',\n\t'Expectation',\n\t'PremiumAmount',\n\t'PaymentMethod',\n\t'AnnualizedPremium',\n    (\n\t\tcase\n\t\t\twhen \"{{cell(query_ViewersInfo.result, 0, \"CampsCommissionVisibility\").asString()}}\" == \"閲覧不可\"\n\t\t\tthen null\n\t\t\telse 'Commission'\n\t\tend\n\t) as 'Commission',\n\t'OppStatus',\n\t'Call',\n\t'AppointmentSetting',\n\t'Approach',\n\t'InitialGraspIntentionDate',\n\t'FinalGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\t'HandlingOfTheElderly',\n\t'親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'実施日②',\n\t'Location2PluralMeeting',\n\t'電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\t'ContractBriefExplanation',\n\t'Contract',\n\t\"rgb(229, 241, 255)\" as '背景色（設計書）',\n\t\"rgb(240, 245, 248)\" as '背景色（グレー1）',\n\t\"rgb(247, 249, 251)\" as '背景色（グレー2）',\n\t\"{{cell(filter_New_DateFieldSetting.selection, 0, \"Label\").asString()}}\" as 'DateFieldSetting',\n\t\"OppSearch_New_OppList\" as 'downloadDefinition'\n;\n\nq = order q by 'No';\n\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["filter_Common_AS","filter_Common_ASBranch","filter_Common_Agent","filter_New_RecordType","filter_New_Date","filter_Common_IncomingChannel_Leads","filter_Common_Account","filter_Common_Group","filter_NewDM_CampaignName","filter_NewDM_CampaignChannel","filter_New_Product","filter_New_Expectation","filter_New_InsuranceCompany","filter_New_ReasonForCancellation","filter_New_OppStatus","filter_NewDM_Project","filter_New_DesignDocGroupName","filter_Common_Team","filter_New_Call","filter_New_AppointmentSetting","filter_New_Approach","filter_New_HandlingOfTheElderly","filter_New_ImpDateWithRelatives","filter_New_LocationWithRelatives","filter_New_AttendeeNameWithRelatives","filter_New_AttendeeRelationshipWithRelatives","filter_New_AttendeeRelationWithRelatives","filter_New_ImpDateAccompany","filter_New_LocationAccompany","filter_New_AccompanyRecruiterName","filter_New_ImpDatePluralMeeting","filter_New_Location1PluralMeeting","filter_New_ImpDate2PluralMeet