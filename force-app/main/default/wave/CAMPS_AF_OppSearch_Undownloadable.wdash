astFacet":true,"datasets":[{"name":"AchievementManagement_OppSearch_OppAssociatedData"}],"isGlobal":false,"label":"フィルター_【DM】【プロセス】実施日①（複数回面談）","query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"ImpDatePluralMeeting\"],\"filters\":[[\"ImpDatePluralMeeting\",[],\"isnotnull\"]]}","version":-1.0},"receiveFacetSource":{"mode":"include","steps":["filter_Common_AS"]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"autoFitMode":"keepLabels","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"sync","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","title":{"fontSize":14,"subtitleFontSize":11,"label":"","align":"center","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"columnMap":{"trellis":[],"dimensionAxis":["ImpDatePluralMeeting"],"plots":["count"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"theme":"wave","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"}},"table_DM_OppList":{"broadcastFacet":true,"groups":[],"numbers":[],"query":"q = load \"AchievementManagement_OppSearch_OppAssociatedData\";\n\nq = filter q by 'OppType' == \"DM/その他\";\n\n--項目がnullの場合グルーピングするとそのレコードが落ちるため、使用する項目を1度すべて出力する（null埋めされる）\nq = foreach q generate\n\tcoalesce('ReceptionDate', \"-\") as 'ReceptionDate',\n\tcoalesce('ProductDescriptionDate2', \"-\") as 'ProductDescriptionDate2',\n\tcoalesce('ContractDate2', \"-\") as 'ContractDate2',\n\tcoalesce('CompletionDate2', \"-\") as 'CompletionDate2',\n\tcoalesce('CancelDate2', \"-\") as 'CancelDate2',\n\t'CampaignName',\n\t'CampaignChannel',\n\t'OppId',\n\t'OppName',\n\t'ProjectName',\n\t'AccountId', \n\t'AccountName', \n\t'GroupName',\n\t'IncomingChannel_Leads',\n\t'Agent_Name', \n\t'ProceedingStaff_Name', \n\t'ApplicationReceptionDate', \n\t'AgreementSendWithBookletDate', \n\t'DefectiveReturnDate', \n\t'ProductDescriptionDate',\n\t'DesignDocId',\n\t'ContractDate', \n\t'FollowUpDateAfterEstablishment', \n\t'CancelDate', \n\t'CompletionDate', \n\t'ProductName',\n\t'DesignDocGroupName',\n\t'PolicyNumber', \n\t'InsuranceCompany',\n\t'Expectation', \n\t'PremiumAmount', \n\t'PaymentMethod', \n\t'AnnualizedPremium',\n\t'Commission',\n\t'OppStatus',\n\t'AS_Code',\n\tmv_to_string('SendingClause') as 'SendingClause',\n\t'InitialGraspIntentionDate',\n\t'FinalGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\tmv_to_string('HandlingOfTheElderly') as 'HandlingOfTheElderly',\n\t'ImpDateWithRelatives' as '親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'ImpDateAccompany' as '同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'ImpDatePluralMeeting' as '複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'ImpDate2PluralMeeting' as '実施日②',\n\t'Location2PluralMeeting',\n\t'ImpDateTelephone' as '電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\tmv_to_string('Contract') as 'Contract'\n;\n\n--パフォーマンス向上のため先にlimit2000を入れる\nq = order q by (\n\t{{cell(filter_DM_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}} desc nulls last,\n\t'AS_Code' asc, \n\t'OppId' desc,\n\t'DesignDocId' desc\n);\n\nq = limit q 2000;\n\n--同じ案件をまとめる、window関数を仕様するためにグルーピング\nq = group q by (\n\t{{cell(filter_DM_DateFieldSetting.selection, 0, \"APIName\").asString()}}, \n\t'CampaignName',\n\t'CampaignChannel',\n\t'OppId',\n\t'OppName', \n\t'ProjectName',\n\t'AccountId', \n\t'AccountName',\n\t'GroupName', \n\t'IncomingChannel_Leads',\n\t'Agent_Name', \n\t'ProceedingStaff_Name',\n\t'ApplicationReceptionDate',\n\t'AgreementSendWithBookletDate',\n\t'DefectiveReturnDate', \n\t'ProductDescriptionDate', \n\t'DesignDocId', \n\t'ContractDate',\n\t'FollowUpDateAfterEstablishment', \n\t'CompletionDate', \n\t'CancelDate', \n\t'ProductName',\n\t'DesignDocGroupName',\n\t'PolicyNumber',\n\t'InsuranceCompany',\n\t'Expectation', \n\t'PremiumAmount', \n\t'PaymentMethod',\n\t'AnnualizedPremium',\n\t'Commission',\n\t'OppStatus',\n\t'AS_Code',\n\t'SendingClause',\n\t'InitialGraspIntentionDate',\n\t'FinalGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\t'HandlingOfTheElderly',\n\t'親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'実施日②',\n\t'Location2PluralMeeting',\n\t'電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\t'Contract'\n);\n--No、設計書No項目作成（この時点でStringにすることで、項目を前に持ってくる※数値だと後ろにいってしまうため）\nq = foreach q generate\n\tnumber_to_string(\n\t\tdense_rank() over(\n\t\t\t[..] partition by all \n\t\t\torder by (\n\t\t\t\t{{cell(filter_DM_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}} desc nulls last,\n\t\t\t\t'AS_Code' asc, \n\t\t\t\t'OppId' desc\n\t\t\t)\n\t\t), \"##\"\n\t) as 'No',\n\t{{cell(filter_DM_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}},\n\t'CampaignName',\n\t'CampaignChannel',\n\t'OppId',\n\t'OppName',\n\t'ProjectName',\n\t'AccountId',\n\t'AccountName', \n\t'GroupName',\n\t'IncomingChannel_Leads',\n\t'Agent_Name',\n\t'ProceedingStaff_Name',\n\t'ApplicationReceptionDate', \n\t'AgreementSendWithBookletDate',\n\t'DefectiveReturnDate', \n\t'ProductDescriptionDate',\n\t'DesignDocId',\n\tnumber_to_string(\n\t\trow_number() over(\n\t\t\t[..] partition by 'OppId' \n\t\t\torder by 'DesignDocId' desc\n\t\t), \"##\"\n\t) as '設計書No',\n\t'ContractDate', \n\t'FollowUpDateAfterEstablishment',\n\t'CompletionDate',\n\t'CancelDate',\n\t'ProductName',\n\t'DesignDocGroupName',\n\t'PolicyNumber',\n\t'InsuranceCompany',\n\t'Expectation',\n\t'PremiumAmount',\n\t'PaymentMethod',\n\t'AnnualizedPremium',\n\t'Commission',\n\t'OppStatus',\n\t'SendingClause',\n\t'InitialGraspIntentionDate',\n\t'FinalGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\t'HandlingOfTheElderly',\n\t'親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'実施日②',\n\t'Location2PluralMeeting',\n\t'電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\t'Contract'\n;\n\n--最終的な出力（設計書No作成時点で並び順がバラバラになってしまう。そこで、最終的にNoで並び替えするためにNoを数値に戻す）※設計書Noを作成しなければNo作成時のorderが効く\nq = foreach q generate\n\tstring_to_number('No') as 'No',\n\t(\n\t\tcase {{cell(filter_DM_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}}\n\t\t\twhen \"-\" then null\n\t\t\telse {{cell(filter_DM_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}}\n\t\tend\n\t) as {{cell(filter_DM_DateFieldSetting.selection, 0, \"APIName\").asGrouping()}},\n\t'CampaignName',\n\t'CampaignChannel',\n\t'OppId',\n\t'OppName',\n\t'ProjectName',\n\t'AccountId',\n\t'AccountName', \n\t'GroupName',\n\t'IncomingChannel_Leads',\n\t'Agent_Name',\n\t'ProceedingStaff_Name',\n\t'ApplicationReceptionDate', \n\t'AgreementSendWithBookletDate',\n\t'DefectiveReturnDate', \n\t'ProductDescriptionDate',\n\t'DesignDocId',\n\t(\n\t\tcase \n\t\t\twhen 'DesignDocId' is not null then 'No' + \"-\" + '設計書No'\n\t\tend\n\t) as '設計書No',\n\t'ContractDate', \n\t'FollowUpDateAfterEstablishment',\n\t'CompletionDate',\n\t'CancelDate',\n\t'ProductName',\n\t'DesignDocGroupName',\n\t'PolicyNumber',\n\t'InsuranceCompany',\n\t'Expectation',\n\t'PremiumAmount',\n\t'PaymentMethod',\n\t'AnnualizedPremium',\n    (\n\t\tcase\n\t\t\twhen \"{{cell(query_ViewersInfo.result, 0, \"CampsCommissionVisibility\").asString()}}\" == \"閲覧不可\"\n\t\t\tthen null\n\t\t\telse 'Commission'\n\t\tend\n\t) as 'Commission',\n\t'OppStatus',\n\t'SendingClause',\n\t'InitialGraspIntentionDate',\n\t'FinalGraspIntentionDate',\n\t'PublicSecurityExplanationDate',\n\t'HandlingOfTheElderly',\n\t'親族等同席 - 実施日',\n\t'LocationWithRelatives',\n\t'AttendeeNameWithRelatives',\n\t'AttendeeRelationshipWithRelatives',\n\t'AttendeeRelationWithRelatives',\n\t'同行 - 実施日',\n\t'LocationAccompany',\n\t'AccompanyRecruiterName',\n\t'複数回面談 - 実施日①',\n\t'Location1PluralMeeting',\n\t'実施日②',\n\t'Location2PluralMeeting',\n\t'電話等 - 実施日',\n\t'ImpMethodTelephone',\n\t'PractitionerTelephone',\n\t'Contract',\n\t\"rgb(229, 241, 255)\" as '背景色（設計書）',\n\t\"rgb(240, 245, 248)\" as '背景色（グレー1）',\n\t\"rgb(247, 249, 251)\" as '背景色（グレー2）',\n\t\"{{cell(filter_DM_DateFieldSetting.selection, 0, \"Label\").asString()}}\" as 'DateFieldSetting',\n\t\"OppSearch_DM_OppList\" as 'downloadDefinition'\n;\n\nq = order q by 'No';\n\nq = limit q 2000;","receiveFacetSource":{"mode":"include","steps":["filter_DM_OppStatus","filter_Common_AS","filter_Common_ASBranch","filter_Common_Agent","filter_Common_IncomingChannel_Leads","filter_DM_ReasonForCancellation","filter_DM_Date","filter_Common_Account","filter_Common_Group","filter_NewDM_CampaignName","filter_NewDM_CampaignChannel","filter_DM_Product","filter_DM_InsuranceCompany","filter_DM_Expectation","filter_NewDM_Project","filter_DM_DesignDocGroupName","filter_Common_Team","